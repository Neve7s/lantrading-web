---
import Layout from "../layouts/Layout.astro";
import empresa from "../data/empresa.json";
import PaymentMethods from "../components/ui/PaymentMethods.astro";
---
<Layout title="Contacto — SAGAS | LAN TRADING S.A." description="Av. Morales Duarez 3015, Lima. Teléfonos, WhatsApp, correos y horarios.">
  <div class="max-w-[1420px] mx-auto px-4 md:px-6 py-8">
    <div class="flex items-center gap-2">
      <span class="w-2 h-2 rounded-full bg-[var(--color-accent)]"></span>
      <span class="text-xs tracking-[0.12em] uppercase font-semibold text-[var(--color-text-muted)]">Contacto</span>
    </div>
    <h1 class="mt-2 font-display font-bold text-[26px]">Contáctanos</h1>
    <p class="text-sm text-[var(--color-text-muted)]">Sede {empresa.sede.direccion} · {empresa.sede.referencia} — Horario {empresa.horarios.lunes_viernes} · Sáb {empresa.horarios.sabados}</p>

    <div class="mt-6 grid lg:grid-cols-[1.1fr_0.9fr] gap-6">
      <!-- info -->
      <div class="space-y-4">
        <div class="card p-6">
          <h3 class="font-display font-semibold">Teléfonos / WhatsApp</h3>
          <div class="mt-3 grid sm:grid-cols-2 gap-2">
            {empresa.contacto.telefonos.filter(t=>t.whatsapp).map(t=>(
              <a href={t.whatsapp} target="_blank" class="flex items-center justify-between p-3 rounded-xl bg-[var(--paper-2)] border border-[var(--color-border)] hover:border-[var(--color-primary)]">
                <span class="font-medium">{t.numero}</span><span class="pill bg-[#25D366] text-white border-transparent text-xs">WhatsApp →</span>
              </a>
            ))}
            <a href={`tel:${empresa.contacto.telefonos[0].numero.replace(/\s/g,'')}`} class="flex items-center justify-between p-3 rounded-xl border border-[var(--color-border)]">
              <span>{empresa.contacto.telefonos[0].numero}</span><span class="text-xs text-[var(--color-text-muted)]">Fijo</span>
            </a>
          </div>
        </div>

        <div class="card p-6">
          <h3 class="font-display font-semibold">Correos</h3>
          <div class="mt-3 grid gap-2">
            {empresa.contacto.emails.map((e,i)=>(
              <a href={`mailto:${e}`} class="flex items-center gap-3 p-3 rounded-xl bg-[var(--paper-2)] border border-[var(--color-border)] hover:bg-white hover:border-[var(--color-primary)]">
                <span class="w-9 h-9 rounded-full bg-white border border-[var(--color-border)] grid place-items-center overflow-hidden">
                  <img src={i%2===0?"/logos/logo_footer_true.png":"/logos/logo_sagas_x2-1.png"} alt="" class="w-7 h-7 object-contain swap-logo" />
                </span>
                <span class="font-medium text-[14px] text-[var(--color-primary)] break-all">{e}</span>
                <span class="ml-auto text-xs pill hidden sm:inline">Escribir →</span>
              </a>
            ))}
          </div>
        </div>

        <PaymentMethods />

        <div class="card p-6">
          <h3 class="font-display font-semibold">Horario</h3>
          <p class="mt-2 text-sm">Lun–Vie: <strong>{empresa.horarios.lunes_viernes}</strong><br>Sáb: <strong>{empresa.horarios.sabados}</strong></p>
          <p class="mt-2 text-xs text-[var(--color-text-muted)]">{empresa.sede.referencia}</p>
        </div>
      </div>

      <!-- mapa + form -->
      <div class="space-y-4">
        <div class="card p-3">
          <iframe title="Mapa SAGAS" src="https://www.google.com/maps?q=Av.+Morales+Duarez+3015+Lima&z=16&output=embed" class="w-full h-[360px] rounded-xl border border-[var(--color-border)]" loading="lazy"></iframe>
          <a href={empresa.sede.mapa_url} target="_blank" class="mt-2 inline-flex text-sm font-medium text-[var(--color-primary)] hover:underline">Abrir en Google Maps →</a>
        </div>

        <div class="card p-6">
          <h3 class="font-display font-semibold">Escríbenos</h3>
          <form class="mt-3 grid gap-3" onsubmit="event.preventDefault(); const f=new FormData(this); const n=f.get('nombre'), e=f.get('email'), m=f.get('mensaje'); const url=`https://api.whatsapp.com/send?phone=51959683123&text=${encodeURIComponent(`Hola SAGAS, soy ${n} (${e}): ${m}`)}`; window.open(url,'_blank');">
            <input name="nombre" placeholder="Nombre" required class="px-3 py-2.5 rounded-xl border border-[var(--color-border)] text-sm" />
            <input name="email" type="email" placeholder="Email" required class="px-3 py-2.5 rounded-xl border border-[var(--color-border)] text-sm" />
            <textarea name="mensaje" placeholder="Mensaje" rows="4" required class="px-3 py-2.5 rounded-xl border border-[var(--color-border)] text-sm"></textarea>
            <button type="submit" class="btn-accent w-full py-3">Enviar por WhatsApp →</button>
          </form>
          <p class="mt-2 text-xs text-[var(--color-text-muted)]">El formulario abre WhatsApp con tu mensaje (sin backend, estático).</p>
        </div>
      </div>
    </div>
  </div>
</Layout>
