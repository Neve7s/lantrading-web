---
import Layout from "../layouts/Layout.astro";
import empresa from "../data/empresa.json";
import PaymentMethods from "../components/ui/PaymentMethods.astro";
---
<Layout title="Contacto — SAGAS | LAN TRADING S.A." description="Av. Morales Duarez 3015, Lima. Teléfonos, WhatsApp, correos y horarios.">
  <div class="max-w-[1420px] mx-auto px-4 md:px-6 py-8">
    <div class="flex items-center gap-2">
      <span class="w-2 h-2 rounded-full bg-[var(--color-accent)]"></span>
      <span class="text-xs tracking-[0.12em] uppercase font-semibold text-[var(--color-text-muted)]">Contacto</span>
    </div>
    <h1 class="mt-2 font-display font-bold text-[26px]">Contáctanos</h1>
    <p class="text-sm text-[var(--color-text-muted)]">Sede {empresa.sede.direccion} · {empresa.sede.referencia} — Horario {empresa.horarios.lunes_viernes} · Sáb {empresa.horarios.sabados}</p>

    <div class="mt-6 grid lg:grid-cols-[1.1fr_0.9fr] gap-6">
      <!-- info -->
      <div class="space-y-4">
        <div class="card p-6">
          <h3 class="font-display font-semibold">Teléfonos / WhatsApp</h3>
          <div class="mt-3 grid sm:grid-cols-2 gap-2">
            {empresa.contacto.telefonos.filter(t=>t.whatsapp).map(t=>(
              <a href={t.whatsapp} target="_blank" class="flex items-center justify-between p-3 rounded-xl bg-[var(--paper-2)] border border-[var(--color-border)] hover:border-[var(--color-primary)]">
                <span class="font-medium flex items-center gap-1.5"><svg width="14" height="14" viewBox="0 0 24 24" fill="#25D366" aria-hidden="true"><path d="M19.05 4.91A9.82 9.82 0 0 0 12.02 2C6.49 2 2.02 6.48 2.02 12.01c0 1.76.46 3.48 1.33 4.99L2 22l5.16-1.35a9.96 9.96 0 0 0 4.86 1.24h.01c5.53 0 10.01-4.48 10.01-10.01 0-2.67-1.04-5.18-2.93-7.07l-.06-.06ZM12.03 20.03h-.01a8.18 8.18 0 0 1-4.17-1.14l-.3-.18-3.06.8.82-2.98-.2-.31a8.2 8.2 0 0 1-1.26-4.21c0-4.54 3.69-8.23 8.23-8.23 2.2 0 4.27.86 5.82 2.41a8.18 8.18 0 0 1 2.41 5.82c0 4.54-3.7 8.23-8.28 8.23Zm6.77-6.16c-.37-.19-2.2-1.09-2.54-1.21-.34-.12-.59-.19-.84.19s-.97 1.21-1.19 1.46c-.22.25-.44.28-.81.09-.37-.19-1.57-.58-2.99-1.85-1.1-.98-1.85-2.2-2.07-2.57-.22-.37-.02-.57.17-.76.17-.17.37-.44.56-.66.19-.22.25-.37.37-.62.12-.25.06-.47-.03-.66-.09-.19-.84-2.02-1.15-2.77-.3-.72-.61-.62-.84-.63l-.72-.01c-.25 0-.66.09-1 .47-.34.37-1.31 1.28-1.31 3.12s1.34 3.62 1.53 3.87c.19.25 2.64 4.03 6.39 5.65.89.39 1.59.62 2.13.79.9.29 1.71.25 2.36.15.72-.11 2.2-.9 2.51-1.77.31-.87.31-1.62.22-1.77-.09-.15-.34-.25-.71-.44Z"/></svg>{t.numero}</span><span class="pill bg-[#25D366] text-white border-transparent text-xs flex items-center gap-1"><svg width="10" height="10" viewBox="0 0 24 24" fill="white" aria-hidden="true"><path d="M19.05 4.91A9.82 9.82 0 0 0 12.02 2C6.49 2 2.02 6.48 2.02 12.01c0 1.76.46 3.48 1.33 4.99L2 22l5.16-1.35a9.96 9.96 0 0 0 4.86 1.24h.01c5.53 0 10.01-4.48 10.01-10.01 0-2.67-1.04-5.18-2.93-7.07l-.06-.06ZM12.03 20.03h-.01a8.18 8.18 0 0 1-4.17-1.14l-.3-.18-3.06.8.82-2.98-.2-.31a8.2 8.2 0 0 1-1.26-4.21c0-4.54 3.69-8.23 8.23-8.23 2.2 0 4.27.86 5.82 2.41a8.18 8.18 0 0 1 2.41 5.82c0 4.54-3.7 8.23-8.28 8.23Zm6.77-6.16c-.37-.19-2.2-1.09-2.54-1.21-.34-.12-.59-.19-.84.19s-.97 1.21-1.19 1.46c-.22.25-.44.28-.81.09-.37-.19-1.57-.58-2.99-1.85-1.1-.98-1.85-2.2-2.07-2.57-.22-.37-.02-.57.17-.76.17-.17.37-.44.56-.66.19-.22.25-.37.37-.62.12-.25.06-.47-.03-.66-.09-.19-.84-2.02-1.15-2.77-.3-.72-.61-.62-.84-.63l-.72-.01c-.25 0-.66.09-1 .47-.34.37-1.31 1.28-1.31 3.12s1.34 3.62 1.53 3.87c.19.25 2.64 4.03 6.39 5.65.89.39 1.59.62 2.13.79.9.29 1.71.25 2.36.15.72-.11 2.2-.9 2.51-1.77.31-.87.31-1.62.22-1.77-.09-.15-.34-.25-.71-.44Z"/></svg>WhatsApp</span>
              </a>
            ))}
            <a href={`tel:${empresa.contacto.telefonos[0].numero.replace(/\s/g,'')}`} class="flex items-center justify-between p-3 rounded-xl border border-[var(--color-border)]">
              <span>{empresa.contacto.telefonos[0].numero}</span><span class="text-xs text-[var(--color-text-muted)]">Fijo</span>
            </a>
          </div>
        </div>

        <div class="card p-6">
          <h3 class="font-display font-semibold">Correos</h3>
          <div class="mt-3 grid gap-2">
            {empresa.contacto.emails.map((e,i)=>(
              <a href={`mailto:${e}`} class="flex items-center gap-3 p-3 rounded-xl bg-[var(--paper-2)] border border-[var(--color-border)] hover:bg-white hover:border-[var(--color-primary)]">
                <span class="w-9 h-9 rounded-full bg-white border border-[var(--color-border)] grid place-items-center overflow-hidden">
                  <img src={i%2===0?"/logos/logo_footer_true.png":"/logos/logo_sagas_x2-1.png"} alt="" class="w-7 h-7 object-contain swap-logo" />
                </span>
                <span class="font-medium text-[14px] text-[var(--color-primary)] break-all">{e}</span>
                <span class="ml-auto text-xs pill hidden sm:inline">Escribir →</span>
              </a>
            ))}
          </div>
        </div>

        <PaymentMethods />

        <div class="card p-6">
          <h3 class="font-display font-semibold">Horario</h3>
          <p class="mt-2 text-sm">Lun–Vie: <strong>{empresa.horarios.lunes_viernes}</strong><br>Sáb: <strong>{empresa.horarios.sabados}</strong></p>
          <p class="mt-2 text-xs text-[var(--color-text-muted)]">{empresa.sede.referencia}</p>
        </div>
      </div>

      <!-- mapa + form -->
      <div class="space-y-4">
        <div class="card p-3">
          <iframe title="Mapa SAGAS" src="https://www.google.com/maps?q=Av.+Morales+Duarez+3015+Lima&z=16&output=embed" class="w-full h-[360px] rounded-xl border border-[var(--color-border)]" loading="lazy"></iframe>
          <a href={empresa.sede.mapa_url} target="_blank" class="mt-2 inline-flex text-sm font-medium text-[var(--color-primary)] hover:underline">Abrir en Google Maps →</a>
        </div>

        <div class="card p-6">
          <h3 class="font-display font-semibold">Escríbenos</h3>
          <form class="mt-3 grid gap-3" onsubmit="event.preventDefault(); const f=new FormData(this); const n=f.get('nombre'), e=f.get('email'), m=f.get('mensaje'); const url=`https://api.whatsapp.com/send?phone=51959683123&text=${encodeURIComponent(`Hola SAGAS, soy ${n} (${e}): ${m}`)}`; window.open(url,'_blank');">
            <div>
              <label for="nombre" class="block text-xs font-medium mb-1">Nombre <span aria-hidden="true" class="text-[var(--color-accent)]">*</span></label>
              <input id="nombre" name="nombre" placeholder="Tu nombre" required autocomplete="name" class="w-full px-3 py-2.5 rounded-xl border border-[var(--color-border)] text-sm focus:outline-none focus:ring-2 focus:ring-[var(--color-primary)]/20 focus:border-[var(--color-primary)]" />
            </div>
            <div>
              <label for="email" class="block text-xs font-medium mb-1">Email <span aria-hidden="true" class="text-[var(--color-accent)]">*</span></label>
              <input id="email" name="email" type="email" placeholder="tu@email.com" required autocomplete="email" class="w-full px-3 py-2.5 rounded-xl border border-[var(--color-border)] text-sm focus:outline-none focus:ring-2 focus:ring-[var(--color-primary)]/20 focus:border-[var(--color-primary)]" />
            </div>
            <div>
              <label for="mensaje" class="block text-xs font-medium mb-1">Mensaje <span aria-hidden="true" class="text-[var(--color-accent)]">*</span></label>
              <textarea id="mensaje" name="mensaje" placeholder="Cuéntanos qué necesitas cotizar..." rows="4" required class="w-full px-3 py-2.5 rounded-xl border border-[var(--color-border)] text-sm focus:outline-none focus:ring-2 focus:ring-[var(--color-primary)]/20 focus:border-[var(--color-primary)]"></textarea>
            </div>
            <button type="submit" class="btn-accent w-full py-3 min-h-[44px]">Enviar por WhatsApp →</button>
          </form>
          <p class="mt-2 text-xs text-[var(--color-text-muted)]">El formulario abre WhatsApp con tu mensaje (sin backend, estático).</p>
        </div>
      </div>
    </div>
  </div>
</Layout>
