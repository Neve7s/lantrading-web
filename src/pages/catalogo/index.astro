---
import Layout from "../../layouts/Layout.astro";
import ProductCard from "../../components/catalog/ProductCard.astro";
import productos from "../../data/productos.json";
import servicios from "../../data/servicios.json";
import categorias from "../../data/categorias.json";

const SERV_IDS = new Set(servicios.map((s:any)=>s.codigo));
const soloProductos = productos.filter((p:any)=> !SERV_IDS.has(p.codigo));

const url = new URL(Astro.request.url);
const catFilter = url.searchParams.get("cat");
let lista = [...soloProductos];
if (catFilter) lista = lista.filter(p => p.categoria?.slug === catFilter);

let porCategoria = new Map();
for (const p of lista) {
  const slug = p.categoria?.slug ?? "otros";
  const arr = porCategoria.get(slug) ?? [];
  if (arr.length < 5) arr.push(p);
  porCategoria.set(slug, arr);
}
const demo = catFilter ? lista.slice(0, 20) : Array.from(porCategoria.values()).flat();
const titulo = catFilter ? `Catálogo · ${categorias.find(c=>c.slug===catFilter)?.nombre ?? catFilter}` : "Catálogo de productos · 5 por categoría";
---
<Layout title={`${titulo} | SAGAS`}>
  <section class="max-w-[1420px] mx-auto px-4 md:px-6 py-6">
    <h1 class="font-display font-bold text-[22px]">{titulo}</h1>
    <p class="text-sm text-[var(--color-text-muted)]">Solo productos · Servicios en <a href="/servicios" class="text-[var(--color-primary)] underline">/servicios</a> (sección separada) · Comprar → WhatsApp ventas</p>

    <div class="mt-4 flex flex-wrap gap-2">
      <a href="/catalogo" class={`pill px-3 py-2 text-sm ${!catFilter?'bg-[var(--color-primary)] text-white border-transparent':''}`}>Productos ({soloProductos.length})</a>
      <a href="/servicios" class="pill px-3 py-2 text-sm border-[var(--color-primary)] text-[var(--color-primary)]">Ver servicios · 4 →</a>
      {categorias.filter(c=>c.productos>0).sort((a,b)=>b.productos-a.productos).slice(0,10).map(c=>(
        <a href={`/catalogo?cat=${c.slug}`} class={`pill px-3 py-2 text-sm ${catFilter===c.slug?'bg-[var(--color-primary)] text-white border-transparent':''}`}>{c.nombre} · {c.productos}</a>
      ))}
    </div>

    <div class="mt-2 text-xs text-[var(--color-text-muted)]">Mostrando {demo.length} productos en demo (5 por categoría, sin servicios). Total real {soloProductos.length} productos.</div>

    <div class="mt-4 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      {demo.map(p=> <ProductCard producto={p} />)}
    </div>
  </section>
</Layout>
