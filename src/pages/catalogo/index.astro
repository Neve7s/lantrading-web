---
import Layout from "../../layouts/Layout.astro";
import productos from "../../data/productos.json";
import servicios from "../../data/servicios.json";
import categorias from "../../data/categorias.json";

const SERV_IDS = new Set(servicios.map((s:any)=>s.codigo));
const soloProductos = productos.filter((p:any)=> !SERV_IDS.has(p.codigo));
const categoriasConProd = categorias.filter(c=>c.productos>0).sort((a,b)=> b.productos - a.productos);
const marcas = [...new Set(soloProductos.map(p=>p.marca).filter(Boolean))].sort();
const url = new URL(Astro.request.url);
const catParam = url.searchParams.get("cat") ?? "";
const slimProductos = soloProductos.map((p:any)=> ({
  codigo: p.codigo,
  nombre: p.nombre,
  slug: p.slug,
  categoria: p.categoria,
  categorias: p.categorias,
  marca: p.marca,
  modelo: p.modelo,
  imagen_principal: p.imagen_principal,
  imagenes: p.imagenes,
  descripcion_corta: p.descripcion_corta,
  especificaciones: (p.especificaciones || []).slice(0,2),
}));
const jsonData = JSON.stringify(slimProductos).replace(/</g, "\\u003c");
---
<Layout title={`Catálogo · ${soloProductos.length} productos | SAGAS`} description={`Catálogo completo con ${soloProductos.length} balanzas y maquinaria SAGAS. Filtra por categoría y marca.`} canonical="/catalogo">
  <section class="max-w-[1420px] mx-auto px-4 md:px-6 py-6">
    <div class="flex flex-wrap items-start justify-between gap-4">
      <div>
        <h1 class="font-display font-bold text-[22px]">Catálogo completo</h1>
        <p class="text-sm text-[var(--color-text-muted)]">
          <span id="catalog-count" aria-live="polite" aria-atomic="true">Mostrando 24 de {soloProductos.length} productos</span> · Solo productos · Servicios en <a href="/servicios" class="text-[var(--color-primary)] underline">/servicios</a>
        </p>
      </div>
      <a href="/servicios" class="pill px-3 py-2 text-sm border-[var(--color-primary)] text-[var(--color-primary)] hidden md:inline-flex">Ver servicios · 4 →</a>
    </div>

    <div class="mt-5 card p-4 flex flex-col gap-4">
      <div class="grid grid-cols-1 md:grid-cols-[1.4fr_1fr_1fr_auto] gap-3">
        <label class="relative">
          <span class="absolute left-3 top-1/2 -translate-y-1/2 text-[var(--color-text-muted)]" aria-hidden="true">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="M20 20L16.5 16.5"/></svg>
          </span>
          <input id="search" type="search" placeholder="Buscar por nombre, código, marca, modelo..." aria-label="Buscar productos" class="w-full pl-9 pr-3 py-2.5 rounded-xl border border-[var(--color-border)] bg-[var(--paper-2)] text-sm focus:outline-none focus:ring-2 focus:ring-[var(--color-primary)]/20 focus:border-[var(--color-primary)]" />
        </label>
        <label class="sr-only" for="cat-select">Categoría</label>
        <select id="cat-select" aria-label="Filtrar por categoría" class="w-full px-3 py-2.5 rounded-xl border border-[var(--color-border)] bg-white text-sm focus:outline-none focus:ring-2 focus:ring-[var(--color-primary)]/20">
          <option value="">Todas las categorías</option>
          {categoriasConProd.map(c=> (
            <option value={c.slug} selected={catParam===c.slug}>{c.nombre} · {c.productos}</option>
          ))}
        </select>
        <label class="sr-only" for="marca-select">Marca</label>
        <select id="marca-select" aria-label="Filtrar por marca" class="w-full px-3 py-2.5 rounded-xl border border-[var(--color-border)] bg-white text-sm focus:outline-none focus:ring-2 focus:ring-[var(--color-primary)]/20">
          <option value="">Todas las marcas</option>
          {marcas.map(m=> <option value={m}>{m}</option>)}
        </select>
        <button id="clear-filters" type="button" class="px-4 py-2.5 rounded-xl border border-[var(--color-border)] bg-white text-sm font-medium hover:bg-[var(--paper-2)] whitespace-nowrap">Limpiar ✕</button>
      </div>
      <div class="flex items-center gap-2 text-xs text-[var(--color-text-muted)]">
        <span>Tip: usa el buscador, el selector de categorías o el de marcas. El filtro es instantáneo sin recargar.</span>
      </div>
    </div>

    <div id="no-results" hidden class="mt-6 card p-8 text-center">
      <div class="text-lg font-semibold">Sin resultados</div>
      <p class="text-sm text-[var(--color-text-muted)] mt-1">Prueba con otra categoría, marca o término de búsqueda.</p>
      <button id="no-results-clear" type="button" class="mt-4 btn-primary">Limpiar filtros</button>
    </div>

    <div id="catalog-grid" class="mt-4 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4" aria-live="polite"></div>

    <div class="mt-6 flex flex-col items-center gap-3">
      <button id="load-more" type="button" class="pill px-6 py-3 text-sm font-medium min-h-[44px]">Cargar más</button>
      <span id="catalog-hint" class="text-xs text-[var(--color-text-muted)]"></span>
    </div>
  </section>

  <script id="catalog-data" type="application/json" set:html={jsonData}></script>

  <script>
    const PER_PAGE = 24;
    let currentPage = 1;
    let filtered = [];
    const rawEl = document.getElementById('catalog-data');
    const raw = rawEl ? JSON.parse(rawEl.textContent || '[]') : [];
    // enrich with searchable text
    const data = raw.map(p => ({
      ...p,
      _search: `${p.nombre} ${p.codigo} ${p.marca || ''} ${p.modelo || ''} ${p.categoria?.nombre || ''} ${p.categoria?.slug || ''} ${(p.categorias||[]).join(' ')} ${(p.especificaciones||[]).join(' ')}`.toLowerCase(),
      _cats: (p.categorias || [p.categoria?.slug]).filter(Boolean).join(',').toLowerCase()
    }));

    const grid = document.getElementById('catalog-grid');
    const searchInput = document.getElementById('search');
    const catSelect = document.getElementById('cat-select');
    const marcaSelect = document.getElementById('marca-select');
    const clearBtn = document.getElementById('clear-filters');
    const noResultsClear = document.getElementById('no-results-clear');
    const countEl = document.getElementById('catalog-count');
    const noResults = document.getElementById('no-results');
    const loadMore = document.getElementById('load-more');
    const hint = document.getElementById('catalog-hint');
    const WHATSAPP_NUM = '51959683123';

    const params = new URLSearchParams(location.search);
    if (params.get('cat')) catSelect.value = params.get('cat');
    if (params.get('q')) searchInput.value = params.get('q');
    if (params.get('marca')) marcaSelect.value = params.get('marca');

    function buildWA(p){
      const msg = `Hola SAGAS 👋, me interesa cotizar:\n\n• ${p.nombre}\n• Código: ${p.codigo}\n• https://sagas.com.pe/product/${p.slug}/\n• Categoría: ${p.categoria?.nombre || ''}\n\n¿Precio y disponibilidad?`;
      return `https://api.whatsapp.com/send?phone=${WHATSAPP_NUM}&text=${encodeURIComponent(msg)}`;
    }
    function truncate(s, n){ return s.length > n ? s.slice(0, n-1) + '…' : s; }
    function escapeHtml(s){ return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }

    function updateURL(cat, q, marca){
      const u = new URL(location.href);
      if(cat) u.searchParams.set('cat', cat); else u.searchParams.delete('cat');
      if(q) u.searchParams.set('q', q); else u.searchParams.delete('q');
      if(marca) u.searchParams.set('marca', marca); else u.searchParams.delete('marca');
      history.replaceState(null,'', u.pathname + (u.search ? u.search : ''));
    }

    function getFiltered(){
      const q = searchInput.value.trim().toLowerCase();
      const cat = (catSelect.value||'').toLowerCase();
      const marca = marcaSelect.value;
      return data.filter(p=>{
        const matchCat = !cat || (p.categoria?.slug||'').toLowerCase()===cat || p._cats.split(',').includes(cat);
        const matchMarca = !marca || p.marca===marca;
        const matchQ = !q || p._search.includes(q);
        return matchCat && matchMarca && matchQ;
      });
    }

    function cardHTML(p, idx){
      const wa = buildWA(p);
      const img = `/${p.imagen_principal}`;
      const shortDesc = truncate(p.descripcion_corta || (p.especificaciones||[]).slice(0,2).join(' · '), 110);
      const isFirstPage = currentPage===1 && idx < 8;
      return `<article class="card overflow-hidden flex flex-col group hover:shadow-[var(--shadow-float)] transition-all">
        <a href="/producto/${escapeHtml(p.slug)}" class="block overflow-hidden bg-[var(--paper-2)]">
          <img src="${escapeHtml(img)}" alt="${escapeHtml(p.nombre)}" width="600" height="450" loading="${isFirstPage ? 'eager' : 'lazy'}" decoding="async" fetchpriority="${isFirstPage ? 'high' : 'auto'}" sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 25vw" class="w-full aspect-[4/3] object-cover group-hover:scale-[1.02] transition duration-300" />
        </a>
        <div class="p-3.5 flex flex-col gap-1.5 flex-1">
          <div class="flex items-center gap-1.5 flex-wrap">
            <span class="text-[10px] tracking-[0.08em] uppercase px-2 py-1 rounded-full bg-[var(--paper-2)] border border-[var(--color-border)] text-[var(--color-text-muted)]">${escapeHtml(p.categoria?.nombre||'General')}</span>
            ${p.marca ? `<span class="text-[10px] px-2 py-1 rounded-full bg-[var(--color-primary)] text-white">${escapeHtml(p.marca)}</span>` : ''}
            ${p.modelo ? `<span class="text-[10px] px-2 py-1 pill">${escapeHtml(p.modelo)}</span>` : ''}
          </div>
          <a href="/producto/${escapeHtml(p.slug)}" class="font-display font-semibold text-[13px] leading-[1.35] line-clamp-2 hover:text-[var(--color-primary)]">${escapeHtml(p.nombre)}</a>
          <p class="text-[12px] text-[var(--color-text-muted)] line-clamp-2">${escapeHtml(shortDesc)}</p>
          <div class="flex items-center gap-1.5 flex-wrap text-[11px] text-[var(--color-text-muted)]">
            <span class="pill px-2 py-1">${p.imagenes.length} fotos</span>
            <span class="pill px-2 py-1">Cód. ${p.codigo}</span>
            <span class="ml-auto text-[11px] font-medium text-[var(--color-accent)]">A cotizar</span>
          </div>
          <div class="mt-2 grid grid-cols-2 gap-2">
            <a href="/producto/${escapeHtml(p.slug)}" class="text-center text-sm font-medium py-2 rounded-full border border-[var(--color-border)] hover:bg-[var(--paper-2)] min-h-[40px] grid place-items-center">Ver detalle</a>
            <a href="${wa}" target="_blank" rel="noopener" aria-label="Comprar ${escapeHtml(p.nombre)} por WhatsApp" class="text-center text-sm font-bold py-2 rounded-full bg-[var(--color-accent)] text-white hover:bg-[var(--red-700)] min-h-[40px] grid place-items-center">Comprar</a>
          </div>
        </div>
      </article>`;
    }

    function render(){
      filtered = getFiltered();
      const total = filtered.length;
      const totalData = data.length;
      const slice = filtered.slice(0, currentPage * PER_PAGE);
      grid.innerHTML = slice.map((p,i)=> cardHTML(p,i)).join('');
      const visible = slice.length;
      if(countEl) countEl.textContent = `Mostrando ${visible} de ${total} productos${total!==totalData ? ` (filtrados de ${totalData})` : ''}`;
      if(hint) hint.textContent = visible < total ? `${total - visible} productos más disponibles` : total ? 'Has visto todos los productos filtrados' : '';
      if(noResults) noResults.hidden = total !== 0;
      grid.hidden = total===0;
      if(loadMore){
        loadMore.hidden = visible >= total;
        loadMore.textContent = visible >= total ? 'No hay más' : `Cargar más (${total - visible} restantes)`;
      }
      updateURL(catSelect.value, searchInput.value.trim(), marcaSelect.value);
    }

    searchInput.addEventListener('input', ()=>{ currentPage=1; render(); });
    catSelect.addEventListener('change', ()=>{ currentPage=1; render(); });
    marcaSelect.addEventListener('change', ()=>{ currentPage=1; render(); });
    loadMore.addEventListener('click', ()=>{ currentPage++; render(); });
    function clearAll(){ searchInput.value=''; catSelect.value=''; marcaSelect.value=''; currentPage=1; render(); }
    clearBtn.addEventListener('click', clearAll);
    noResultsClear?.addEventListener('click', clearAll);
    render();
  </script>
</Layout>
