---
import Layout from "../../layouts/Layout.astro";
import Gallery from "../../components/catalog/Gallery";
import ProductCard from "../../components/catalog/ProductCard.astro";
import { buildWhatsAppUrl } from "../../lib/whatsapp";
import productos from "../../data/productos.json";
import servicios from "../../data/servicios.json";

export async function getStaticPaths() {
  const ids = new Set((servicios as any[]).map(s=>s.codigo));
  const solo = (productos as any[]).filter(p=> !ids.has(p.codigo));
  return solo.map(p=> ({ params: { slug: p.slug }, props: { producto: p } }));
}
const { producto } = Astro.props as { producto: any };
const wa = buildWhatsAppUrl(producto, { categoria: producto.categoria?.nombre });
const _solo = (productos as any[]).filter((p:any)=> !(servicios as any[]).some(s=>s.codigo===p.codigo));
const relacionados = _solo.filter(p=> p.categoria?.slug===producto.categoria?.slug && p.codigo!==producto.codigo).slice(0,4);
---
<Layout title={`${producto.nombre} | SAGAS`} description={producto.descripcion_corta}>
  <div class="max-w-[1420px] mx-auto px-4 md:px-6 py-6">
    <nav class="text-xs text-[var(--color-text-muted)]"><a href="/" class="hover:underline">Inicio</a> / <a href="/catalogo" class="hover:underline">Catálogo</a> / <a href={`/catalogo?cat=${producto.categoria?.slug}`} class="hover:underline">{producto.categoria?.nombre}</a> / <span class="text-[var(--color-text)]">{producto.nombre}</span></nav>

    <div class="mt-4 grid lg:grid-cols-[1.1fr_0.9fr] gap-6">
      <Gallery client:load imagenes={producto.imagenes} nombre={producto.nombre} />
      <div class="flex flex-col gap-4">
        <div>
          <div class="flex flex-wrap gap-2">
            <span class="pill px-3 py-1 text-xs">{producto.categoria?.nombre}</span>
            <span class="px-2.5 py-1 rounded-full text-xs bg-[var(--color-primary)] text-white">{producto.marca}</span>
            {producto.modelo && <span class="pill px-3 py-1 text-xs">{producto.modelo}</span>}
            <span class="pill px-3 py-1 text-xs">Cód. {producto.codigo}</span>
          </div>
          <h1 class="mt-3 font-display font-bold text-[22px] leading-tight">{producto.nombre}</h1>
          <p class="mt-2 text-sm leading-relaxed text-[var(--color-text-muted)]">{producto.descripcion_corta}</p>
        </div>

        <div class="card p-4">
          <div class="text-xs uppercase tracking-wide font-semibold text-[var(--color-text-muted)]">Especificaciones</div>
          <div class="mt-2 grid gap-1.5">
            {producto.especificaciones.length ? producto.especificaciones.map((s:string)=>(
              <div class="flex gap-2 text-sm"><span class="text-[var(--color-text-muted)]">•</span><span>{s}</span></div>
            )) : <div class="text-sm text-[var(--color-text-muted)]">Consulta por WhatsApp para ficha técnica completa.</div>}
          </div>
          {producto.beneficios.length>0 && (
            <div class="mt-3 pt-3 border-t border-[var(--color-border)]">
              <div class="text-xs font-semibold">Beneficios</div>
              <div class="mt-1 flex flex-wrap gap-1.5">{producto.beneficios.map((b:string)=>(<span class="pill px-2.5 py-1 text-xs">{b}</span>))}</div>
            </div>
          )}
        </div>

        <div class="card p-4 flex flex-col gap-3">
          <div class="text-sm font-bold text-[var(--color-accent)]">A cotizar · Precio por WhatsApp</div>
          <a href={wa} target="_blank" class="btn-accent text-center text-[15px] py-3">Comprar por WhatsApp →</a>
          <div class="text-xs text-[var(--color-text-muted)]">Te responde ventas en minutos. Envíos a todo el Perú · Garantía 1 año.</div>
        </div>
      </div>
    </div>

    {relacionados.length>0 && (
      <section class="mt-10">
        <h2 class="font-display font-bold text-[18px]">Productos relacionados</h2>
        <div class="mt-3 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
          {relacionados.map(p=> <ProductCard producto={p} />)}
        </div>
      </section>
    )}
  </div>
</Layout>
