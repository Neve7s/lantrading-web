---
import Layout from "../layouts/Layout.astro";
import ProductCard from "../components/catalog/ProductCard.astro";
import ServiceCard from "../components/catalog/ServiceCard.astro";
import HeroCarousel from "../components/HeroCarousel";
import empresa from "../data/empresa.json";
import productos from "../data/productos.json";
import servicios from "../data/servicios.json";
import categorias from "../data/categorias.json";

// excluir servicios del catálogo de productos
const SERV_IDS = new Set(servicios.map((s:any)=>s.codigo));
const soloProductos = productos.filter((p:any)=> !SERV_IDS.has(p.codigo));

// 5 por categoria para entregable
const porCategoria = new Map<string, any[]>();
for (const p of soloProductos) {
  const slug = p.categoria?.slug ?? "otros";
  const arr = porCategoria.get(slug) ?? [];
  if (arr.length < 5) arr.push(p);
  porCategoria.set(slug, arr);
}
const destacados = Array.from(porCategoria.values()).flat().slice(0, 12);
const catsConProd = categorias.filter(c=> (porCategoria.get(c.slug)?.length ?? 0)>0).sort((a,b)=> b.productos-a.productos).slice(0,12);
---
<Layout title="SAGAS — Balanzas y maquinaria | 40 años">
  <!-- HERO IMPACTANTE -->
  <section class="relative overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-br from-[var(--blue-900)] via-[var(--blue-800)] to-[#0F172A]"></div>
    <div class="absolute inset-0 opacity-[0.07]" style="background-image: radial-gradient(circle at 2px 2px, white 1px, transparent 0); background-size: 28px 28px;"></div>
    <div class="absolute -top-24 -right-24 w-[520px] h-[520px] bg-[var(--red-600)] rounded-full blur-[90px] opacity-20"></div>
    <div class="absolute -bottom-32 -left-32 w-[600px] h-[600px] bg-white rounded-full blur-[100px] opacity-[0.06]"></div>
    <div class="relative max-w-[1420px] mx-auto px-4 md:px-6 py-10 md:py-14">
      <div class="grid lg:grid-cols-[1.1fr_0.9fr] gap-8 items-center">
        <div class="text-white">
          <div class="inline-flex items-center gap-2 bg-white/10 backdrop-blur border border-white/20 rounded-full px-4 py-1.5 text-xs tracking-wide">
            <span class="w-2 h-2 rounded-full bg-[#25D366] animate-pulse"></span> 40 AÑOS · LÍDERES EN EL PERÚ
          </div>
          <h1 class="mt-4 font-display font-bold text-[36px] md:text-[56px] leading-[0.9] tracking-tight">
            MÁQUINAS<br><span class="text-white">QUE NO</span> <span class="text-[#FF3B30]">FALLAN</span>
          </h1>
          <p class="mt-4 text-[16px] leading-relaxed text-white/80 max-w-[560px]">{empresa.identidad.descripcion}. Fabricación, importación y servicio técnico calificado — envíos a todo el Perú, garantía 1 año.</p>
          <div class="mt-6 flex flex-wrap gap-3">
            <a href="/catalogo" class="inline-flex items-center gap-2 bg-white text-[var(--blue-900)] px-6 py-3.5 rounded-full font-bold text-sm hover:bg-gray-100 transition shadow-lg">Ver catálogo →</a>
            <a href="/nosotros" class="inline-flex items-center gap-2 bg-transparent border border-white/30 text-white px-6 py-3.5 rounded-full font-medium text-sm hover:bg-white/10 transition">Nuestra historia</a>
          </div>
          <div class="mt-8 grid grid-cols-3 gap-3 max-w-[460px]">
            <div class="bg-white/10 backdrop-blur border border-white/20 rounded-2xl p-3 text-center">
              <div class="font-display font-bold text-[22px] text-white">288</div><div class="text-xs text-white/70">productos</div>
            </div>
            <div class="bg-white/10 backdrop-blur border border-white/20 rounded-2xl p-3 text-center">
              <div class="font-display font-bold text-[22px] text-white">64</div><div class="text-xs text-white/70">categorías</div>
            </div>
            <div class="bg-white text-[var(--blue-900)] rounded-2xl p-3 text-center">
              <div class="font-display font-bold text-[22px]">40+</div><div class="text-xs opacity-70">años</div>
            </div>
          </div>
        </div>
        <div class="relative">
          <div class="absolute inset-0 bg-gradient-to-tr from-white/10 to-transparent rounded-[24px] blur-xl"></div>
          <div class="relative">
            <HeroCarousel client:load />
            <div class="absolute -bottom-4 -left-4 bg-white rounded-2xl shadow-[var(--shadow-float)] p-3 flex items-center gap-3 hidden md:flex">
              <div class="grid h-10 w-10 place-items-center rounded-full bg-[#25D366] text-white shadow-sm">
              <svg viewBox="0 0 24 24" aria-hidden="true" class="h-5 w-5 fill-none stroke-current stroke-[2.7] leading-none">
                <path d="M5 12.5 9.5 17 19 7.5" />
              </svg>
            </div>
              <div class="text-sm"><div class="font-semibold">Garantía 1 año</div><div class="text-xs text-[var(--color-text-muted)]">Certificado incluido</div></div>
            </div>
          </div>
        </div>
      </div>
      <div class="mt-8 max-w-[460px] space-y-2.5">
        {empresa.propuesta_valor.slice(0,4).map(v=>(
          <div class="flex items-center gap-3 rounded-2xl border border-white/15 bg-white/8 px-3 py-2.5 text-white backdrop-blur-sm">
            <div class="grid h-8 w-8 shrink-0 place-items-center rounded-full bg-white text-[var(--blue-900)] shadow-sm">
              <svg viewBox="0 0 24 24" aria-hidden="true" class="h-4 w-4 fill-none stroke-current stroke-[2.7] leading-none">
                <path d="M5 12.5 9.5 17 19 7.5" />
              </svg>
            </div>
            <div class="text-sm font-medium leading-snug">{v}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- NOSOTROS teaser → página dedicada -->
  <section class="max-w-[1420px] mx-auto px-4 md:px-6 py-6">
    <div class="card p-6 md:p-8 flex flex-col md:flex-row gap-6 items-start">
      <div class="flex-1">
        <div class="flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-[var(--color-accent)]"></span>
          <span class="text-xs tracking-[0.12em] uppercase font-semibold text-[var(--color-text-muted)]">Nosotros</span>
        </div>
        <h2 class="mt-2 font-display font-bold text-[20px]">LAN TRADING S.A. · 40 años</h2>
        <p class="mt-2 text-sm leading-relaxed text-[var(--color-text-muted)]">
          Distribuidor nacional fabricando y distribuyendo balanzas y maquinaria. {empresa.historia.fundacion.slice(0,160)}…
        </p>
        <a href="/nosotros" class="mt-4 inline-flex btn-primary">Conoce nuestra historia →</a>
      </div>
      <div class="grid grid-cols-3 gap-2 w-full md:w-[360px] shrink-0">
        <div class="p-3 rounded-xl bg-[var(--paper-2)] border border-[var(--color-border)] text-center"><div class="font-bold">1982</div><div class="text-xs text-[var(--color-text-muted)]">Fundación</div></div>
        <div class="p-3 rounded-xl bg-[var(--paper-2)] border border-[var(--color-border)] text-center"><div class="font-bold">2004</div><div class="text-xs text-[var(--color-text-muted)]">LAN TRADING</div></div>
        <div class="p-3 rounded-xl bg-[var(--paper-2)] border border-[var(--color-border)] text-center"><div class="font-bold">2007</div><div class="text-xs text-[var(--color-text-muted)]">Expansión</div></div>
      </div>
    </div>
  </section>

  <!-- CATEGORIAS -->
  <section class="max-w-[1420px] mx-auto px-4 md:px-6 py-6">
    <h2 class="font-display font-bold text-[18px]">Categorías</h2>
    <p class="text-sm text-[var(--color-text-muted)]">Catálogo de productos · 5 por categoría en demo (servicios en sección aparte)</p>
    <div class="mt-4 grid grid-cols-2 md:grid-cols-4 lg:grid-cols-6 gap-3">
      {catsConProd.map(c=>(
        <a href={`/catalogo?cat=${c.slug}`} class="card p-4 hover:shadow-[var(--shadow-float)] transition group">
          <div class="text-sm font-semibold group-hover:text-[var(--color-primary)]">{c.nombre}</div>
          <div class="text-xs text-[var(--color-text-muted)]">{c.productos} productos · {porCategoria.get(c.slug)?.length ?? 0} en demo</div>
          <div class="mt-2 text-xs font-medium text-[var(--color-accent)]">Ver →</div>
        </a>
      ))}
    </div>
  </section>

  <!-- DESTACADOS productos (sin servicios) -->
  <section class="max-w-[1420px] mx-auto px-4 md:px-6 py-6">
    <div class="flex items-end justify-between gap-2">
      <h2 class="font-display font-bold text-[18px]">Destacados · productos</h2>
      <a href="/catalogo" class="text-sm font-medium text-[var(--color-primary)] hover:underline">Ver catálogo →</a>
    </div>
    <div class="mt-4 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      {destacados.map(p=> <ProductCard producto={p} />)}
    </div>
  </section>

  <!-- SERVICIOS — sección separada 2x2 -->
  <section id="servicios" class="max-w-[1420px] mx-auto px-4 md:px-6 py-6">
    <div class="flex items-end justify-between gap-2">
      <div>
        <h2 class="font-display font-bold text-[18px]">Servicios técnicos <span class="text-[var(--color-text-muted)] font-normal text-sm">· sección aparte</span></h2>
        <p class="text-sm text-[var(--color-text-muted)]">Soporte calificado, repuestos originales y garantía · no están en el catálogo de productos</p>
      </div>
      <a href="/servicios" class="hidden md:inline text-sm font-medium text-[var(--color-primary)] hover:underline">Ver todos →</a>
    </div>
    <div class="mt-4 grid grid-cols-1 md:grid-cols-2 gap-5">
      {servicios.map(s=> <ServiceCard servicio={s} />)}
    </div>
  </section>

  <!-- MARCAS -->
  <section id="marcas" class="max-w-[1420px] mx-auto px-4 md:px-6 py-6">
    <h2 class="font-display font-bold text-[18px]">Marcas</h2>
    <div class="mt-3 flex flex-wrap gap-2">
      {empresa.extra.marcos_marcas_banners.map(m=>(
        <span class="pill px-3 py-1.5 text-xs font-medium uppercase tracking-wide">{m}</span>
      ))}
    </div>
  </section>



  <!-- CONTACTO + MAPA -->
  <section id="contacto" class="max-w-[1420px] mx-auto px-4 md:px-6 pb-6">
    <div class="grid lg:grid-cols-2 gap-4">
      <div class="card p-6">
        <div class="flex items-center justify-between">
          <h3 class="font-display font-bold">Contacto</h3>
          <a href="/contacto" class="text-xs font-medium text-[var(--color-primary)] hover:underline">Ver página completa →</a>
        </div>
        <p class="text-sm text-[var(--color-text-muted)]">{empresa.sede.direccion} · {empresa.sede.referencia}</p>
        <div class="mt-3 grid grid-cols-2 gap-2 text-sm">
          {empresa.contacto.telefonos.filter(t=>t.whatsapp).map(t=>(
            <a href={t.whatsapp} target="_blank" class="pill px-3 py-2 flex items-center justify-center gap-1.5 hover:bg-[var(--paper-2)]"><svg width="14" height="14" viewBox="0 0 24 24" fill="#25D366" aria-hidden="true"><path d="M19.05 4.91A9.82 9.82 0 0 0 12.02 2C6.49 2 2.02 6.48 2.02 12.01c0 1.76.46 3.48 1.33 4.99L2 22l5.16-1.35a9.96 9.96 0 0 0 4.86 1.24h.01c5.53 0 10.01-4.48 10.01-10.01 0-2.67-1.04-5.18-2.93-7.07l-.06-.06ZM12.03 20.03h-.01a8.18 8.18 0 0 1-4.17-1.14l-.3-.18-3.06.8.82-2.98-.2-.31a8.2 8.2 0 0 1-1.26-4.21c0-4.54 3.69-8.23 8.23-8.23 2.2 0 4.27.86 5.82 2.41a8.18 8.18 0 0 1 2.41 5.82c0 4.54-3.7 8.23-8.28 8.23Zm6.77-6.16c-.37-.19-2.2-1.09-2.54-1.21-.34-.12-.59-.19-.84.19s-.97 1.21-1.19 1.46c-.22.25-.44.28-.81.09-.37-.19-1.57-.58-2.99-1.85-1.1-.98-1.85-2.2-2.07-2.57-.22-.37-.02-.57.17-.76.17-.17.37-.44.56-.66.19-.22.25-.37.37-.62.12-.25.06-.47-.03-.66-.09-.19-.84-2.02-1.15-2.77-.3-.72-.61-.62-.84-.63l-.72-.01c-.25 0-.66.09-1 .47-.34.37-1.31 1.28-1.31 3.12s1.34 3.62 1.53 3.87c.19.25 2.64 4.03 6.39 5.65.89.39 1.59.62 2.13.79.9.29 1.71.25 2.36.15.72-.11 2.2-.9 2.51-1.77.31-.87.31-1.62.22-1.77-.09-.15-.34-.25-.71-.44Z"/></svg>{t.numero}</a>
          ))}
        </div>
        <div class="mt-4">
          <div class="text-xs font-semibold tracking-wide uppercase text-[var(--color-text-muted)]">Correos</div>
          <div class="mt-2 grid gap-2">
            {empresa.contacto.emails.map((e,i)=>(
              <a href={`mailto:${e}`} class="flex items-center gap-3 p-3 rounded-xl bg-[var(--paper-2)] border border-[var(--color-border)] hover:bg-white hover:border-[var(--color-primary)] group">
                <span class="w-9 h-9 rounded-full bg-white border border-[var(--color-border)] grid place-items-center overflow-hidden shrink-0">
                  <img src={i % 2 === 0 ? "/logos/logo_footer_true.png" : "/logos/logo_sagas_x2-1.png"} alt="LAN TRADING" class="w-7 h-7 object-contain swap-logo" loading="lazy" />
                </span>
                <span class="font-medium text-[14px] text-[var(--color-primary)] break-all">{e}</span>
                <span class="ml-auto text-xs pill px-2 py-1 hidden sm:inline">Escribir →</span>
              </a>
            ))}
          </div>
        </div>
        <div class="mt-3 text-sm">Horario: {empresa.horarios.lunes_viernes} · Sáb {empresa.horarios.sabados}</div>
        <a href="/contacto" class="mt-4 inline-flex btn-primary w-full justify-center">Ir a contacto completo →</a>
      </div>
      <div class="card p-3">
        <iframe title="Mapa SAGAS" src="https://www.google.com/maps?q=Av.+Morales+Duarez+3015+Lima&z=16&output=embed" class="w-full h-[260px] rounded-xl border border-[var(--color-border)]" loading="lazy"></iframe>
      </div>
    </div>
  </section>
</Layout>
