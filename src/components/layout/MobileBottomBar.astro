---
---
<nav class="lg:hidden fixed bottom-0 inset-x-0 z-40">
  <!-- pegado abajo, sin margen -->
  <div class="bg-white border-t border-[var(--color-border)] rounded-t-[20px] shadow-[0_-8px_24px_rgba(15,42,74,0.12)] flex items-center justify-around px-2 pt-2 pb-[max(8px,env(safe-area-inset-bottom))]">
    <a href="/" data-bottom="inicio" class="flex flex-col items-center gap-1 py-1.5 px-4 rounded-xl text-[11px] font-medium text-[var(--color-text-muted)] hover:text-[var(--color-primary)] transition">
      <span class="w-6 h-6 grid place-items-center">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/><path d="M9 22V12h6v10"/></svg>
      </span>
      Inicio
    </a>
    <a href="/catalogo" data-bottom="tienda" class="flex flex-col items-center gap-1 py-1.5 px-4 rounded-xl text-[11px] font-medium text-[var(--color-text-muted)] hover:text-[var(--color-primary)] transition">
      <span class="w-6 h-6 grid place-items-center">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 01-8 0"/></svg>
      </span>
      Tienda
    </a>
    <button type="button" id="bottom-cart-btn" class="relative flex flex-col items-center gap-1 py-1.5 px-4 rounded-xl text-[11px] font-medium text-[var(--color-text-muted)] hover:text-[var(--color-primary)] transition">
      <span class="w-6 h-6 grid place-items-center relative">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 6h15l-1.5 9h-13z"/><path d="M6 6L5 2H2"/><circle cx="9" cy="20" r="1.5"/><circle cx="18" cy="20" r="1.5"/></svg>
        <span data-cart-count class="hidden absolute -top-1 -right-1 min-w-[16px] h-[16px] px-1 rounded-full bg-[var(--color-accent)] text-white text-[10px] font-bold grid place-items-center leading-none">0</span>
      </span>
      Carrito
    </button>
  </div>
</nav>

<style>
  /* evita que el contenido quede tapado en mobile */
  @media (max-width: 1023px) {
    :global(body) { padding-bottom: 76px; }
  }
</style>

<script>
  // activo según ruta
  const path = location.pathname;
  const inicio = document.querySelector('[data-bottom="inicio"]');
  const tienda = document.querySelector('[data-bottom="tienda"]');
  const activeCls = 'bg-[var(--color-primary)] text-white';
  if (path === '/' || path === '/index.html') {
    inicio?.classList.add('bg-[var(--color-primary)]','text-white');
    inicio?.classList.remove('text-[var(--color-text-muted)]');
  } else if (path.startsWith('/catalogo') || path.startsWith('/producto')) {
    tienda?.classList.add('bg-[var(--color-primary)]','text-white');
    tienda?.classList.remove('text-[var(--color-text-muted)]');
  }
  // abrir carrito
  document.getElementById('bottom-cart-btn')?.addEventListener('click', () => {
    document.getElementById('cart-btn')?.click();
  });
</script>
