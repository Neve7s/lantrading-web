---
import productos from "../../data/productos.json";
// 16 imágenes aleatorias para collage
const collage = [...productos].sort(()=>0.5-Math.random()).slice(0,16);
---
<div aria-hidden="true" class="fixed inset-0 -z-10 overflow-hidden pointer-events-none">
  <div class="absolute inset-0 grid grid-cols-4 md:grid-cols-8 gap-1 opacity-[0.09] blur-[6px] scale-105">
    {collage.map(p=>(
      <img src={`/${p.imagen_principal}`} alt="" loading="lazy" class="w-full h-full object-cover aspect-square" />
    ))}
    {collage.map(p=>(
      <img src={`/${p.imagen_principal}`} alt="" loading="lazy" class="w-full h-full object-cover aspect-square hidden md:block" />
    ))}
  </div>
  <div class="absolute inset-0 bg-gradient-to-b from-white/70 via-white/60 to-[var(--paper)]"></div>
</div>
