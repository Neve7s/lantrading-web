---
import empresa from "../../data/empresa.json";
import PaymentMethods from "../ui/PaymentMethods.astro";
const telHref = (n:string)=> `tel:${n.replace(/\s|\(|\)|-/g,'')}`;
---
<footer class="mt-16 border-t border-[var(--color-border)] bg-white">
  <div class="max-w-[1420px] mx-auto px-4 md:px-6 py-10 grid grid-cols-1 md:grid-cols-4 gap-8">
    <div>
      <div class="flex items-center gap-3">
        <img src="/logos/logo_sagas_x2-1.png" alt="SAGAS" width="84" height="52" class="h-10 w-auto object-contain" loading="lazy" />
        <img src="/logos/logo_footer_true.png" alt="LAN TRADING S.A." width="100" height="34" class="h-8 w-auto object-contain" loading="lazy" />
      </div>
      <p class="mt-3 text-sm text-[var(--color-text-muted)] leading-relaxed">{empresa.identidad.descripcion}. {empresa.propuesta_valor.slice(0,2).join(" · ")}.</p>
      <div class="mt-4 flex gap-2">
        <a href={empresa.redes_sociales.facebook} target="_blank" aria-label="Facebook" class="w-9 h-9 rounded-full bg-[#1877F2] text-white grid place-items-center hover:opacity-90">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="white" aria-hidden="true"><path d="M24 12c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 22.954 24 17.99 24 12z"/></svg>
        </a>
        <a href={empresa.redes_sociales.instagram} target="_blank" aria-label="Instagram" class="w-9 h-9 rounded-full bg-gradient-to-br from-[#F58529] via-[#DD2A7B] to-[#515BD4] text-white grid place-items-center hover:opacity-90">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="white" aria-hidden="true"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
        </a>
        <a href={empresa.redes_sociales.tiktok} target="_blank" aria-label="TikTok" class="w-9 h-9 rounded-full bg-black text-white grid place-items-center hover:opacity-90">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="white" aria-hidden="true"><path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"/></svg>
        </a>
        <a href={empresa.redes_sociales.youtube} target="_blank" aria-label="YouTube" class="w-9 h-9 rounded-full bg-[#FF0000] text-white grid place-items-center hover:opacity-90">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="white" aria-hidden="true"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
        </a>
      </div>
    </div>
    <div>
      <h4 class="font-display font-semibold text-sm">Sede</h4>
      <p class="mt-2 text-sm text-[var(--color-text-muted)]">{empresa.sede.direccion}<br>{empresa.sede.referencia}</p>
      <p class="mt-2 text-sm"><span class="font-medium">Horario:</span> {empresa.horarios.lunes_viernes} · Sáb {empresa.horarios.sabados}</p>
    </div>
    <div>
      <h4 class="font-display font-semibold text-sm">Contacto</h4>
      <ul class="mt-2 space-y-1.5 text-sm">
        {empresa.contacto.telefonos.map(t=>(
          <li class="flex items-center gap-2"><a href={telHref(t.numero)} class="hover:text-[var(--color-primary)]">{t.numero}</a> {t.whatsapp && <a href={t.whatsapp} target="_blank" aria-label="WhatsApp" class="w-6 h-6 rounded-full bg-[#25D366] text-white grid place-items-center"><svg width="12" height="12" viewBox="0 0 24 24" fill="white" aria-hidden="true"><path d="M19.05 4.91A9.82 9.82 0 0 0 12.02 2C6.49 2 2.02 6.48 2.02 12.01c0 1.76.46 3.48 1.33 4.99L2 22l5.16-1.35a9.96 9.96 0 0 0 4.86 1.24h.01c5.53 0 10.01-4.48 10.01-10.01 0-2.67-1.04-5.18-2.93-7.07l-.06-.06ZM12.03 20.03h-.01a8.18 8.18 0 0 1-4.17-1.14l-.3-.18-3.06.8.82-2.98-.2-.31a8.2 8.2 0 0 1-1.26-4.21c0-4.54 3.69-8.23 8.23-8.23 2.2 0 4.27.86 5.82 2.41a8.18 8.18 0 0 1 2.41 5.82c0 4.54-3.7 8.23-8.28 8.23Zm6.77-6.16c-.37-.19-2.2-1.09-2.54-1.21-.34-.12-.59-.19-.84.19s-.97 1.21-1.19 1.46c-.22.25-.44.28-.81.09-.37-.19-1.57-.58-2.99-1.85-1.1-.98-1.85-2.2-2.07-2.57-.22-.37-.02-.57.17-.76.17-.17.37-.44.56-.66.19-.22.25-.37.37-.62.12-.25.06-.47-.03-.66-.09-.19-.84-2.02-1.15-2.77-.3-.72-.61-.62-.84-.63l-.72-.01c-.25 0-.66.09-1 .47-.34.37-1.31 1.28-1.31 3.12s1.34 3.62 1.53 3.87c.19.25 2.64 4.03 6.39 5.65.89.39 1.59.62 2.13.79.9.29 1.71.25 2.36.15.72-.11 2.2-.9 2.51-1.77.31-.87.31-1.62.22-1.77-.09-.15-.34-.25-.71-.44Z"/></svg></a>}</li>
        ))}
      </ul>
      <div class="mt-3">
        <div class="text-xs font-semibold tracking-wide uppercase text-[var(--color-text-muted)]">Correos</div>
        <div class="mt-1.5 grid gap-1.5">
          {empresa.contacto.emails.map((e,i)=>(
            <a href={`mailto:${e}`} class="flex items-center gap-2 px-2.5 py-1.5 rounded-lg bg-[var(--paper-2)] border border-[var(--color-border)] hover:border-[var(--color-primary)]">
              <span class="w-6 h-6 rounded-full bg-white border border-[var(--color-border)] grid place-items-center overflow-hidden shrink-0">
                <img src={i % 2 === 0 ? "/logos/logo_footer_true.png" : "/logos/logo_sagas_x2-1.png"} alt="" class="w-5 h-5 object-contain swap-logo" loading="lazy" />
              </span>
              <span class="text-[13px] font-medium text-[var(--color-primary)] break-all">{e}</span>
            </a>
          ))}
        </div>
      </div>
    </div>
     <div>
      <h4 class="font-display font-semibold text-sm">Empresa</h4>
      <p class="mt-2 text-[12px] leading-relaxed text-[var(--color-text-muted)]">
        <strong>{empresa.identidad.razon_social_principal}</strong> · {empresa.historia.fundacion.slice(0,110)}…<br>
        <a href="/nosotros" class="text-[var(--color-primary)] hover:underline">Ver historia completa →</a>
      </p>
      <div class="mt-3 text-[11px] text-[var(--color-text-muted)]">© 2026 SAGAS. Más de 40 años al servicio del Perú.</div>
    </div>
  </div>
  <div class="max-w-[1420px] mx-auto px-4 md:px-6 pb-8">
    <PaymentMethods />
  </div>
  <div class="border-t border-[var(--color-border)] py-3 text-center text-[11px] text-[var(--color-text-muted)]">
    Hecho con estilo escandinavo · Azul #0B2A4A · Rojo #E53935 · Blanco · Datos reales de <code>datos-sagas/</code>
  </div>
</footer>
