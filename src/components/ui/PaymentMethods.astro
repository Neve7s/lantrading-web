---
---
<div class="card p-3 sm:p-4">
  <div class="mb-3 flex items-center gap-2">
    <span class="h-[3px] w-6 rounded-full bg-[var(--color-accent)]"></span>
    <h4 class="font-display text-xs font-bold tracking-[0.14em] sm:text-sm">MÉTODOS DE PAGO</h4>
  </div>
  <div class="grid grid-cols-2 gap-2 sm:grid-cols-3 lg:grid-cols-4">
    <!-- BCP -->
    <div class="grid min-h-[52px] place-items-center rounded-lg border border-[var(--color-border)] bg-[#002A8D] px-2 text-center font-bold tracking-tight text-white text-[11px] sm:text-[13px]">≫ BCP ≪</div>
    <!-- Diners -->
    <div class="grid min-h-[52px] place-items-center rounded-lg border border-[var(--color-border)] bg-white px-2 text-center text-[9px] font-semibold leading-[1.1] text-[#004A9A] sm:text-[11px]">◯ Diners Club<br><span class="tracking-[0.2em] text-[7px] sm:text-[8px]">INTERNATIONAL</span></div>
    <!-- Amex -->
    <div class="grid min-h-[52px] place-items-center rounded-lg bg-[#016FD0] px-2 text-center text-[8px] font-bold leading-[1.1] text-white sm:text-[9px]">AMERICAN<br>EXPRESS</div>
    <!-- BBVA -->
    <div class="grid min-h-[52px] place-items-center rounded-lg border border-[var(--color-border)] bg-white px-2 text-[13px] font-bold tracking-wide text-[#004481] sm:text-[15px]">BBVA</div>
    <!-- Visa -->
    <div class="grid min-h-[52px] place-items-center rounded-lg border border-[var(--color-border)] bg-white px-2 text-center text-[13px] font-bold tracking-tight text-[#1A1F71] sm:text-[16px]">VISA<span class="mt-0.5 block h-1 w-10 rounded-full bg-[#FAAD3D] sm:w-12"></span></div>
    <!-- Mastercard -->
    <div class="grid min-h-[52px] place-items-center rounded-lg bg-black px-2">
      <div class="flex items-center gap-1"><span class="h-6 w-6 rounded-full bg-[#EB001B]"></span><span class="-ml-2 h-6 w-6 rounded-full bg-[#F79E1B]"></span><span class="ml-1 text-[7px] font-bold text-white sm:text-[8px]">MasterCard</span></div>
    </div>
    <!-- Niubiz -->
    <div class="grid min-h-[52px] place-items-center rounded-lg border border-[var(--color-border)] bg-white px-2 text-[12px] font-bold tracking-tight text-black sm:text-[14px]">niubiz<span class="text-[#00B8E6]">:</span></div>
    <!-- Yape -->
    <div class="grid min-h-[52px] place-items-center rounded-lg bg-[#742BE0] px-2 text-center text-[13px] font-bold text-white sm:text-[16px]">yape<span class="ml-1 grid h-5 w-5 place-items-center rounded-full bg-[#00E5C0] text-[9px] text-[#742BE0]">S/</span></div>
  </div>
  <p class="mt-2 text-[10px] text-[var(--color-text-muted)] sm:text-[11px]">Tarjetas, transferencias BCP/BBVA, Niubiz y Yape. También Plin y efectivo.</p>
</div>
