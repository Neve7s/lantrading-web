---
---
<div class="card p-3 sm:p-4">
  <div class="mb-3 flex items-center gap-2">
    <span class="h-[3px] w-6 rounded-full bg-[var(--color-accent)]"></span>
    <h4 class="font-display text-xs font-bold tracking-[0.14em] sm:text-sm">MÉTODOS DE PAGO</h4>
  </div>
  <!-- Logos reales desde internet — solo imagen, sin texto -->
  <div class="grid grid-cols-4 gap-2 sm:gap-3">
    <div class="flex h-[52px] sm:h-[56px] items-center justify-center rounded-lg border border-[var(--color-border)] bg-white p-2">
      <img src="https://cdn.simpleicons.org/visa/1A1F71" alt="Visa" width="48" height="16" class="h-6 sm:h-7 w-auto object-contain" loading="lazy" />
    </div>
    <div class="flex h-[52px] sm:h-[56px] items-center justify-center rounded-lg border border-[var(--color-border)] bg-white p-2">
      <img src="https://upload.wikimedia.org/wikipedia/commons/2/2a/Mastercard-logo.svg" alt="Mastercard" width="36" height="22" class="h-7 sm:h-8 w-auto object-contain" loading="lazy" />
    </div>
    <div class="flex h-[52px] sm:h-[56px] items-center justify-center rounded-lg border border-[var(--color-border)] bg-white p-2">
      <img src="https://cdn.simpleicons.org/americanexpress/2E77BC" alt="American Express" width="48" height="16" class="h-6 w-auto object-contain" loading="lazy" />
    </div>
    <div class="flex h-[52px] sm:h-[56px] items-center justify-center rounded-lg border border-[var(--color-border)] bg-white p-2">
      <img src="https://cdn.simpleicons.org/dinersclub/0079BE" alt="Diners Club" width="36" height="22" class="h-7 w-auto object-contain" loading="lazy" />
    </div>
    <div class="flex h-[52px] sm:h-[56px] items-center justify-center rounded-lg border border-[var(--color-border)] bg-white p-2">
      <img src="https://upload.wikimedia.org/wikipedia/commons/0/0d/Logo-bcp-vector.svg" alt="BCP" width="64" height="20" class="h-5 sm:h-6 w-auto object-contain" loading="lazy" />
    </div>
    <div class="flex h-[52px] sm:h-[56px] items-center justify-center rounded-lg bg-white p-2 border border-[var(--color-border)]">
      <img src="https://upload.wikimedia.org/wikipedia/commons/0/05/BBVA_2019.svg" alt="BBVA" width="64" height="20" class="h-5 sm:h-6 w-auto object-contain" loading="lazy" />
    </div>
    <div class="flex h-[52px] sm:h-[56px] items-center justify-center rounded-lg border border-[var(--color-border)] bg-white p-2">
      <img src="https://www.niubiz.com.pe/wp-content/uploads/2021/08/logo-niubiz.png" alt="Niubiz" width="64" height="20" class="h-5 sm:h-6 w-auto object-contain" loading="lazy" onerror="this.src='https://cdn.simpleicons.org/paypal/003087'" />
    </div>
    <div class="flex h-[52px] sm:h-[56px] items-center justify-center rounded-lg border border-[var(--color-border)] bg-white p-2">
      <img src="https://upload.wikimedia.org/wikipedia/commons/0/08/Icono_de_la_aplicaci%C3%B3n_Yape.png" alt="Yape" width="40" height="40" class="h-8 sm:h-9 w-auto object-contain" loading="lazy" />
    </div>
  </div>
  <p class="sr-only">Aceptamos Visa, Mastercard, American Express, Diners, BCP, BBVA, Niubiz y Yape.</p>
</div>
