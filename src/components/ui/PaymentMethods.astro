---
---
<div class="card p-4">
  <div class="flex items-center gap-2 mb-3">
    <span class="w-6 h-[3px] rounded-full bg-[var(--color-accent)]"></span>
    <h4 class="font-display font-bold text-sm tracking-wide">MÉTODOS DE PAGO</h4>
  </div>
  <div class="grid grid-cols-4 gap-2">
    <!-- BCP -->
    <div class="h-[52px] rounded-lg bg-[#002A8D] text-white grid place-items-center font-bold text-[13px] tracking-tight border border-[var(--color-border)]">≫ BCP ≪</div>
    <!-- Diners -->
    <div class="h-[52px] rounded-lg bg-white border border-[var(--color-border)] grid place-items-center text-[11px] font-semibold text-[#004A9A] leading-none text-center">◯ Diners Club<br><span class="text-[8px] tracking-widest">INTERNATIONAL</span></div>
    <!-- Amex -->
    <div class="h-[52px] rounded-lg bg-[#016FD0] text-white grid place-items-center font-bold text-[9px] leading-none text-center">AMERICAN<br>EXPRESS</div>
    <!-- BBVA -->
    <div class="h-[52px] rounded-lg bg-white border border-[var(--color-border)] grid place-items-center font-bold text-[#004481] text-[15px] tracking-wide">BBVA</div>
    <!-- Visa -->
    <div class="h-[52px] rounded-lg bg-white border border-[var(--color-border)] grid place-items-center font-bold text-[#1A1F71] text-[16px] tracking-tight">VISA<span class="block h-1 w-12 bg-[#FAAD3D] rounded-full mt-0.5"></span></div>
    <!-- Mastercard -->
    <div class="h-[52px] rounded-lg bg-black grid place-items-center">
      <div class="flex items-center gap-1"><span class="w-6 h-6 rounded-full bg-[#EB001B]"></span><span class="w-6 h-6 rounded-full bg-[#F79E1B] -ml-2"></span><span class="text-white text-[8px] font-bold ml-1">MasterCard</span></div>
    </div>
    <!-- Niubiz -->
    <div class="h-[52px] rounded-lg bg-white border border-[var(--color-border)] grid place-items-center font-bold text-black text-[14px] tracking-tight">niubiz<span class="text-[#00B8E6]">:</span></div>
    <!-- Yape -->
    <div class="h-[52px] rounded-lg bg-[#742BE0] text-white grid place-items-center font-bold text-[16px]">yape<span class="ml-1 w-5 h-5 rounded-full bg-[#00E5C0] grid place-items-center text-[10px] text-[#742BE0]">S/</span></div>
  </div>
  <p class="mt-2 text-[11px] text-[var(--color-text-muted)]">Tarjetas, transferencias BCP/BBVA, Niubiz y Yape. También Plin y efectivo.</p>
</div>
